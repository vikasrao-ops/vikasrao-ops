# ==============================================================================
# Master .gitignore for Vikas Rao Engineering Portfolio Workspace
# ==============================================================================

# OS & Editor generated files
Thumbs.db
[Dd]esktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo

# Node & Frontend Build Caches
node_modules/
.next/
out/
build/
dist/
.npm
*.log
.turbo

# Terraform State & Local Cache
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Secrets, Keys, Certificates & Tokens
*.pem
*.key
*.pub
*.pfx
*.p12
*.crt
*.cert
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.token
*.pat
secrets.yaml
secrets.json

# Local Prometheus / Grafana storage dumps
prometheus_data/
grafana_data/

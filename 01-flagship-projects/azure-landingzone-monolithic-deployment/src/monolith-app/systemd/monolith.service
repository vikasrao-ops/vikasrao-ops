[Unit]
Description=Enterprise Monolithic Application Service
Documentation=https://github.com/Vikas98Rao/azure-landingzone-monolithic-deployment
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/monolith-app
Environment=NODE_ENV=production
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/monolith-app/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
